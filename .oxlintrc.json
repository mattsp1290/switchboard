{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "oxc"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "typescript/no-explicit-any": "error",
    "typescript/ban-ts-comment": ["error", {
      "ts-expect-error": true,
      "ts-ignore": true,
      "ts-nocheck": true
    }]
  },
  "env": {
    "node": true
  },
  "ignorePatterns": ["dist/**", "node_modules/**"]
}
