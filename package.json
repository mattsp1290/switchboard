{
  "name": "@mattsp1290/switchboard",
  "version": "0.0.0",
  "private": true,
  "description": "TypeScript interfaces and adapters for native agent runtimes",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./agui": {
      "types": "./dist/agui/index.d.ts",
      "import": "./dist/agui/index.js"
    },
    "./testkit": {
      "types": "./dist/testkit/index.d.ts",
      "import": "./dist/testkit/index.js"
    },
    "./pi": {
      "types": "./dist/pi/index.d.ts",
      "import": "./dist/pi/index.js"
    },
    "./codex": {
      "types": "./dist/codex/index.d.ts",
      "import": "./dist/codex/index.js"
    }
  },
  "files": [
    "dist",
    "docs/architecture/boundaries.md",
    "licenses/codex-APACHE-2.0.txt",
    "licenses/codex-NOTICE.txt",
    "THIRD_PARTY_NOTICES.md"
  ],
  "engines": {
    "node": ">=24.22.3 <25"
  },
  "packageManager": "npm@11.19.1",
  "scripts": {
    "clean": "node --input-type=module -e 'import { rmSync } from \"node:fs\"; rmSync(\"dist\", { recursive: true, force: true });'",
    "build": "npm run clean && tsc -p tsconfig.json && npm run build:pi && npm run build:codex",
    "lint": "oxlint --deny-warnings .",
    "check": "tsc -p tsconfig.json --noEmit && npm run check:pi && npm run check:codex",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "verify:package": "node scripts/verify-package.mjs",
    "verify:compiler": "node spikes/native-compiler/support/run.mjs \"$npm_execpath\"",
    "verify:agui": "node scripts/verify-agui-matrix.mjs",
    "build:pi": "tsc -p adapters/pi/tsconfig.json",
    "check:pi": "tsc -p adapters/pi/tsconfig.json --noEmit",
    "build:codex": "tsc -p adapters/codex/tsconfig.json",
    "check:codex": "tsc -p adapters/codex/tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@ag-ui/core": "1.0.4",
    "@earendil-works/pi-ai": "1.5.2",
    "@earendil-works/pi-coding-agent": "1.5.2",
    "@types/node": "24.19.2",
    "oxlint": "1.93.0",
    "typescript": "7.0.2",
    "@openai/codex-sdk": "0.169.0"
  },
  "peerDependencies": {
    "@ag-ui/core": "1.0.4",
    "@earendil-works/pi-ai": "1.5.2",
    "@earendil-works/pi-coding-agent": "1.5.2",
    "@openai/codex-sdk": "0.169.0"
  },
  "peerDependenciesMeta": {
    "@ag-ui/core": {
      "optional": true
    },
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@openai/codex-sdk": {
      "optional": true
    }
  }
}
