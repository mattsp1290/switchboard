{
  "name": "@mattsp1290/switchboard",
  "version": "0.0.0",
  "private": true,
  "description": "TypeScript interfaces and adapters for native agent runtimes",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./agui": {
      "types": "./dist/agui/index.d.ts",
      "import": "./dist/agui/index.js"
    }
  },
  "files": [
    "dist",
    "docs/architecture/boundaries.md"
  ],
  "engines": {
    "node": ">=24.22.3 <25"
  },
  "packageManager": "npm@11.19.1",
  "scripts": {
    "clean": "node --input-type=module -e 'import { rmSync } from \"node:fs\"; rmSync(\"dist\", { recursive: true, force: true });'",
    "build": "npm run clean && tsc -p tsconfig.json",
    "lint": "oxlint --deny-warnings .",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "verify:package": "node scripts/verify-package.mjs",
    "verify:compiler": "node spikes/native-compiler/support/run.mjs \"$npm_execpath\"",
    "verify:agui": "node scripts/verify-agui-matrix.mjs"
  },
  "devDependencies": {
    "@ag-ui/core": "https://raw.githubusercontent.com/mattsp1290/agentui/661216eab627be33067951ffad7a1691127a80fe/vendor/ag-ui/ed2c1d5b63299d3f08676a1418cc2640bbe55fd1/ag-ui-core-1.0.4.tgz",
    "@types/node": "24.19.2",
    "oxlint": "1.93.0",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "@ag-ui/core": "1.0.4"
  },
  "peerDependenciesMeta": {
    "@ag-ui/core": {
      "optional": true
    }
  }
}
